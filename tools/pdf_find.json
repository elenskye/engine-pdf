{
  "name": "pdf_find",
  "title": "在 PDF 中找文字",
  "description": "找一个词或一句话，支持简繁、全角半角、连字和换行断词。整句在搜索范围内没有命中时，按同一页内共现的词查找。扫描页每次都要在本机现做识别（每页约半秒），长扫描件请用 pages 缩小范围，或先用 pdf_searchable 生成可搜索副本再找。找不到可缩短词句，或换个说法。",
  "params": {
    "type": "object",
    "properties": {
      "file": {"type": "string", "description": "宿主授权的 PDF 文件标识。CLI 传本机路径。"},
      "query": {"type": "string", "description": "要找的词或句子。"},
      "pages": {"type": "string", "description": "物理页范围，例如 1,3-5 或 8-。省略搜索全书。"},
      "max_hits": {"type": "integer", "minimum": 0, "maximum": 100, "default": 20, "description": "最多交回几处。0 只计数。"},
      "context": {"type": "integer", "minimum": 0, "maximum": 200, "default": 40, "description": "命中前后各保留多少字。"},
      "ocr": {"type": "boolean", "default": true, "description": "缺少可定位文字时用本机 Vision 补做 OCR。关闭后仍可查已有 OCR 层。"},
      "languages": {"type": "array", "items": {"type": "string"}, "maxItems": 8, "default": ["zh-Hans", "zh-Hant", "en-US"], "description": "按优先顺序列出 Vision 的 BCP 47 语言标记。"}
    },
    "required": ["file", "query"]
  },
  "result": "Markdown 按页列出命中原文及前后文。data 给精确或按词方式、来源、物理页码、可选页标签和按行分开的原 PDF 坐标框。框无法核实时仍返回命中，可按页定位。结果截断时可提高 max_hits 或缩小 pages。",
  "result_schema": {
    "type": "object",
    "properties": {
      "hits": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "location": {
              "type": "object",
              "properties": {
                "page": {"type": "integer", "minimum": 1, "maximum": 4294967295, "description": "原文件的物理页码，从 1 起。"},
                "label": {"type": "string"},
                "rects": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {"x": {"type": "number"}, "y": {"type": "number"}, "width": {"type": "number", "minimum": 0}, "height": {"type": "number", "minimum": 0}},
                    "required": ["x", "y", "width", "height"],
                    "description": "原 PDF 坐标。单位 pt，左下原点，保留 CropBox 偏移。"
                  }
                }
              },
              "required": ["page", "rects"]
            },
            "before": {"type": "string"},
            "matched": {"type": "string"},
            "after": {"type": "string"},
            "how": {"type": "string", "enum": ["phrase", "words"]},
            "source": {"type": "string", "enum": ["text", "ocr"]}
          },
          "required": ["location", "before", "matched", "after", "how", "source"]
        },
        "maxItems": 100
      },
      "total": {"type": "integer", "minimum": 0, "maximum": 4294967295},
      "truncated": {"type": "boolean"}
    },
    "required": ["hits", "total", "truncated"]
  },
  "errors": [
    {"kind": "not_pdf", "message": "这不是 PDF 文件。", "hint": "请换一份 PDF。", "retry": false},
    {"kind": "damaged_pdf", "message": "这份 PDF 已损坏，打不开。", "hint": "请用原始文件或重新导出 PDF。", "retry": false},
    {"kind": "locked", "message": "这份 PDF 加了密码，打不开。", "hint": "请让用户提供 PDF 的打开密码。", "retry": false},
    {"kind": "wrong_password", "message": "PDF 密码不正确。", "hint": "请让用户重新提供 PDF 密码。", "retry": false},
    {"kind": "render_failed", "message": "这一页画不出来。", "hint": "请尝试读取文字或换一个页码。", "retry": false},
    {"kind": "ocr_failed", "message": "这一页识别失败。", "hint": "请检查页图，或缩小识别范围。", "retry": false}
  ],
  "cost": {"kind": "local"},
  "confirm": {"kind": "never"},
  "effects": {"network": false, "writes": "none"},
  "examples": [
    {"args": {"file": "samples/out/mixed.pdf", "query": "清晨的港口", "pages": "4"}, "expect": {"data": {"total": 1, "truncated": false}}},
    {"args": {"file": "samples/out/mixed.pdf", "query": "quiet valley", "pages": "2"}, "expect": {"data": {"total": 1, "truncated": false}}}
  ]
}
