{
  "name": "pdf_outline",
  "title": "读取 PDF 目录",
  "description": "读 PDF 内嵌书签。按原目录顺序返回，帮助判断章节落在哪一页。无内嵌目录时，可用 pdf_find 找章节标题。",
  "params": {
    "type": "object",
    "properties": {
      "file": {"type": "string", "description": "宿主授权的 PDF 文件标识。CLI 传本机路径。"},
      "offset": {"type": "integer", "minimum": 0, "maximum": 4294967295, "default": 0, "description": "从第几个条目接着取，第一条为 0。"},
      "limit": {"type": "integer", "minimum": 1, "maximum": 100, "default": 20}
    },
    "required": ["file"]
  },
  "result": "Markdown 按层级列标题及目标页。data 是按深度优先顺序展平的目录条目和总条数，每条含从 1 起的层级索引与目标。还有条目时，Output.next 带原参数和新的 offset，可直接接着取。",
  "result_schema": {
    "type": "object",
    "properties": {
      "items": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "path": {"type": "array", "items": {"type": "integer", "minimum": 1, "maximum": 4294967295, "description": "原文件的物理页码，从 1 起。"}},
            "title": {"type": "string"},
            "target": {"type": "object"}
          },
          "required": ["path", "title", "target"]
        },
        "maxItems": 100
      },
      "total": {"type": "integer", "minimum": 0, "maximum": 4294967295}
    },
    "required": ["items", "total"]
  },
  "errors": [
    {"kind": "not_pdf", "message": "这不是 PDF 文件。", "hint": "请换一份 PDF。", "retry": false},
    {"kind": "damaged_pdf", "message": "这份 PDF 已损坏，打不开。", "hint": "请用原始文件或重新导出 PDF。", "retry": false},
    {"kind": "locked", "message": "这份 PDF 加了密码，打不开。", "hint": "请让用户提供 PDF 的打开密码。", "retry": false},
    {"kind": "wrong_password", "message": "PDF 密码不正确。", "hint": "请让用户重新提供 PDF 密码。", "retry": false}
  ],
  "cost": {"kind": "local"},
  "confirm": {"kind": "never"},
  "effects": {"network": false, "writes": "none"},
  "examples": [
    {"args": {"file": "samples/out/outline.pdf"}, "expect": {"contains": "第 1 页"}}
  ]
}
