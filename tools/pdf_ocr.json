{
  "name": "pdf_ocr",
  "title": "本机识别 PDF 页面",
  "description": "指定物理页用 Vision 识别印刷文字，适合扫描图。公式、表格结构需要 Mathpix 时，先取得用户同意。",
  "params": {
    "type": "object",
    "properties": {
      "file": {"type": "string", "description": "宿主授权的 PDF 文件标识。CLI 传本机路径。"},
      "pages": {"type": "array", "items": {"type": "integer", "minimum": 1, "maximum": 4294967295, "description": "原文件的物理页码，从 1 起。"}, "maxItems": 20, "description": "按给定顺序识别，可重复。"},
      "languages": {"type": "array", "items": {"type": "string"}, "maxItems": 8, "default": ["zh-Hans", "zh-Hant", "en-US"], "description": "按优先顺序列出 Vision 的 BCP 47 语言标记。"}
    },
    "required": ["file", "pages"]
  },
  "result": "Markdown 按页给出识别文本和置信度。data 附页码、可选页标签、平均置信度及各行文字和框。长页的 Markdown 给摘录，data 保留所有行。超出页数上限时分批传 pages。",
  "result_schema": {
    "type": "object",
    "properties": {
      "pages": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "index": {"type": "integer", "minimum": 1, "maximum": 4294967295, "description": "原文件的物理页码，从 1 起。"},
            "label": {"type": "string"},
            "confidence": {"type": "number"},
            "lines": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "text": {"type": "string"},
                  "confidence": {"type": "number", "minimum": 0, "maximum": 1},
                  "bounds": {
                    "type": "object",
                    "properties": {"x": {"type": "number"}, "y": {"type": "number"}, "width": {"type": "number", "minimum": 0}, "height": {"type": "number", "minimum": 0}},
                    "required": ["x", "y", "width", "height"],
                    "description": "原 PDF 坐标。单位 pt，左下原点，保留 CropBox 偏移。"
                  }
                },
                "required": ["text", "confidence", "bounds"]
              }
            }
          },
          "required": ["index", "confidence", "lines"]
        },
        "maxItems": 20
      }
    },
    "required": ["pages"]
  },
  "errors": [
    {"kind": "not_pdf", "message": "这不是 PDF 文件。", "hint": "请换一份 PDF。", "retry": false},
    {"kind": "damaged_pdf", "message": "这份 PDF 已损坏，打不开。", "hint": "请用原始文件或重新导出 PDF。", "retry": false},
    {"kind": "locked", "message": "这份 PDF 加了密码，打不开。", "hint": "请让用户提供 PDF 的打开密码。", "retry": false},
    {"kind": "wrong_password", "message": "PDF 密码不正确。", "hint": "请让用户重新提供 PDF 密码。", "retry": false},
    {"kind": "render_failed", "message": "这一页画不出来。", "hint": "请尝试读取文字或换一个页码。", "retry": false},
    {"kind": "ocr_failed", "message": "这一页识别失败。", "hint": "请检查页图，或缩小识别范围。", "retry": false}
  ],
  "cost": {"kind": "local"},
  "confirm": {"kind": "never"},
  "effects": {"network": false, "writes": "none"},
  "examples": [
    {"args": {"file": "samples/out/mixed.pdf", "pages": [2]}, "expect": {"contains": "quiet valley"}}
  ]
}
